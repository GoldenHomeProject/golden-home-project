[Unit]
Description=GHP Daily Trending Roundup (fresh best-seller content every day)
# Why: GitHub Actions runner IPs get bot-blocked by Amazon; the Pi's residential IP
# is not challenged. Scrapes Amazon Best Sellers live, keeps the cheap high-rating
# winners, EXCLUDES recently-featured ASINs (fresh products daily), and publishes a
# dated buyer-intent roundup post. Fixes the "$0 from recycling the same evergreen
# products" problem (see feedback_ghp_trending_not_evergreen).
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-%h/.ghp-secrets/claude.env
Type=oneshot
WorkingDirectory=%h/golden-home-project
# Pull fresh main before generating so we build on the latest queue/history.
# autoStash: the engagement/DM/Pinterest bots leave their state files dirty in the
# working tree, and a plain `pull --rebase` hard-fails (exit 128) on unstaged
# changes -- that killed the very first run. Leading `-` so a pull failure still
# lets today's post be generated from local state rather than skipping the day.
ExecStartPre=-/usr/bin/git -C %h/golden-home-project -c rebase.autoStash=true pull --quiet --rebase origin main
# xvfb-run gives Playwright a display even with no desktop session logged in.
ExecStart=/usr/bin/xvfb-run -a %h/.ghp-trending/venv/bin/python automation/trending_daily.py
# Commit + push only the trending artifacts, if anything changed. Retry to absorb
# the engagement/IG bots' frequent commits to main (same autoStash reason as above).
ExecStartPost=/bin/bash -c 'shopt -s nullglob; cd %h/golden-home-project && git add -- blog/posts/*trending*best-sellers.html blog/index.html social/trending_picks_*.json social/trending_featured_history.json 2>/dev/null || true; if ! git diff --staged --quiet; then git -c user.name="GHP Trending Bot" -c user.email="goldenhomeprojectllc@gmail.com" commit -m "trending: daily best-seller roundup $(date -u +%%Y-%%m-%%d)" --quiet && for i in 1 2 3 4 5; do git -c rebase.autoStash=true pull --rebase --quiet origin main && git push --quiet origin main && echo "[push] ok" && exit 0; sleep 5; done; echo "[push] FAILED after 5 tries - commit is local only"; exit 1; fi'
StandardOutput=append:%h/.ghp-trending/runs/last.log
StandardError=append:%h/.ghp-trending/runs/last.log
TimeoutStartSec=900

[Install]
WantedBy=default.target
